{
  "appId": "com.nearune.app",
  "appName": "Nearune",
  "webDir": "www",
  "server": {
    "url": "https://nearune.ai",
    "cleartext": false,
    "allowNavigation": [
      "nearune.ai",
      "same-sky-rooms-production.up.railway.app",
      "*.nearune.com",
      "*.nearune.app"
    ]
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#FAF6EE"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#FAF6EE",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
